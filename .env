# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433  # Исправлено с 51213 на 5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agri_rental
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/agri_rental  # Исправлено

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380  # Исправлено с 51214 на 6380
REDIS_PASSWORD=  # Оставьте пустым, если пароль не установлен
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_SECRET_EXP=7d
JWT_SECRET_EXP=1h

# OTP
OTP_EXPIRY_MINUTES=10
REGISTRATION_SESSION_MINUTES=15

# Refresh Tokens
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_MAX_SESSIONS=5

# Environment
NODE_ENV=development
PORT=3000

# Default admin bootstrap
ADMIN_EMAIL=admin@agri-rental.local
ADMIN_PASSWORD=Admin12345!

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
